<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- tools\package.ps1 builds the shared "Cube Radar.exe" as a Windows app without a console window. -->
    <OutputType Condition="'$(CubeRadarWindowsApp)' == 'true'">WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cuberadar</AssemblyName>
    <Version>0.9.5</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\cuberadar.ico</ApplicationIcon>
    <Product>Radar de cubes FR</Product>
    <AssemblyTitle>Radar de cubes FR</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used by the overlay; keep its names (Orientation, Timer, …) out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CubeRadar.Core\CubeRadar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default protocol configuration is embedded; no web UI or web runtime. -->
    <EmbeddedResource Include="..\..\config\*.json" LogicalName="config/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
